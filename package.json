{
  "name": "data-cloud-compare",
  "version": "1.0.0",
  "private": true,
  "description": "Data Cloud Compare: comparator, Bun + React explorer, marketing site and documentation",
  "scripts": {
    "dev": "bun run --cwd app dev",
    "start": "bun run --cwd app start",
    "dev:docs": "npm --prefix docs run start",
    "build": "npm run build:site",
    "build:docs": "npm --prefix docs run build",
    "build:site": "npm run build:docs && bun scripts/assemble-site.ts",
    "preview": "bun scripts/serve-dist.ts",
    "clean": "rm -rf dist docs/build docs/.docusaurus",
    "dev:explorer": "bun run --cwd app dev",
    "start:explorer": "bun run --cwd app start",
    "build:explorer": "bun run --cwd app build",
    "typecheck:explorer": "bun run --cwd app typecheck",
    "screenshots": "bun run tools/screenshots/run.ts",
    "screenshots:baseline": "bun run tools/screenshots/run.ts --target reference",
    "screenshots:after": "bun run tools/screenshots/run.ts --target after",
    "screenshots:compare": "bun run tools/screenshots/run.ts --target compare",
    "screenshots:reference": "bun run tools/screenshots/run.ts --target reference"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  }
}
